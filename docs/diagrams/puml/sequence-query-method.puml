@startuml sequence-query-method
' The QUERY method: a safe, idempotent request that carries a body.
skinparam shadowing false
skinparam backgroundColor white
skinparam sequence {
  ArrowColor #333333
  LifeLineBorderColor #999999
  ParticipantBackgroundColor #F2F2F2
  ParticipantBorderColor #666666
}
autonumber

actor Client
participant "Binding"            as B
participant "EndpointController" as C
participant "JsonBodyAdapter"    as A
participant "QueryBuilder"       as QB

Client -> B : QUERY /users\n{ "where": { "age": { "gte": 30 } } }
B -> B : parse JSON body
B -> C : handle(route, request with body)
C -> A : supports(input)
A --> C : true
C -> A : parse(input, ctx)
A -> QB : build(rawSpec, model, ctx)
QB --> A : QuerySpec
A --> C : QuerySpec
C --> B : payload
B --> Client : 200
@enduml
