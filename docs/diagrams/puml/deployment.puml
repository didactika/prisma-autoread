@startuml deployment
' The library adds no process, port or network hop.
skinparam shadowing false
skinparam backgroundColor white
skinparam node {
  BackgroundColor #F2F2F2
  BorderColor #666666
}
skinparam ArrowColor #333333

node "Client tier" {
  component "Browser / SPA"           as browser
  component "Service-to-service client" as service
}

node "Application node\n<i>Node.js runtime</i>" {
  component "HTTP server\nExpress · Fastify · Hono" as server
  component "prisma-autoread\n<i>in-process library</i>" as lib
  component "Prisma Client\n<i>+ query engine</i>"      as prisma
}

node "Data tier" {
  database "Relational database" as db
}

browser --> server : HTTPS
service --> server : HTTPS · QUERY
server  --> lib
lib     --> prisma
prisma  --> db : TCP / file

note bottom
  The only outbound dependency is the Prisma Client
  the application already has.
end note
@enduml
