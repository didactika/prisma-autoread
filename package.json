{
  "name": "@didactika/prisma-autoread",
  "version": "1.1.2",
  "description": "Auto-generate Prisma read/search APIs for Express, NestJS, Fastify and Hono — GET/QUERY/POST, filtering, RSQL/OData, aggregations, cursor pagination, OpenAPI, HAL, JSON:API and CSV.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    },
    "./nest": {
      "types": "./dist/nest.d.ts",
      "require": "./dist/nest.js",
      "import": "./dist/nest.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:e2e": "prisma generate && prisma db push --force-reset && jest --testPathPattern=tests/e2e",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run test:unit && npm run test:integration && npm run build"
  },
  "keywords": [
    "prisma",
    "express",
    "nestjs",
    "fastify",
    "hono",
    "rest",
    "openapi",
    "swagger",
    "filter",
    "search",
    "pagination",
    "cursor",
    "rsql",
    "odata",
    "jsonapi",
    "hal",
    "aggregate",
    "query-method",
    "middleware",
    "autoread"
  ],
  "author": "Didactika <info@didactika.org>",
  "contributors": [
    "Eduardo Estrada <me@e2rd0.com>",
    "Hector Arrechea <hectorlazaroarrechea@gmail.com>"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/didactika/prisma-autoread.git"
  },
  "homepage": "https://github.com/didactika/prisma-autoread#readme",
  "bugs": {
    "url": "https://github.com/didactika/prisma-autoread/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/swagger": "^7.0.0 || ^8.0.0 || ^11.0.0 || ^12.0.0",
    "@prisma/client": ">=5.0.0",
    "express": ">=4.0.0",
    "reflect-metadata": "^0.1.12 || ^0.2.0",
    "rxjs": "^7.1.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "@nestjs/swagger": {
      "optional": true
    },
    "reflect-metadata": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    }
  },
  "dependencies": {
    "halson": "^3.1.0",
    "http-response-client": "^2.0.1"
  },
  "devDependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/client": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.0",
    "express": "^5.2.1",
    "jest": "^29.0.0",
    "prisma": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0"
  }
}
